# Canonical / Open Graph base URL (no trailing slash). Production: https://your-domain.com
# VITE_SITE_URL=http://localhost:5173

# Optional 1200×630 absolute image URL for og:image and twitter:image
# VITE_OG_IMAGE=https://your-domain.com/og.jpg

# Laravel API (empty = same-origin + Vite proxy to backend)
# VITE_API_URL=

# API route prefix for axios calls (leading slash, no trailing slash)
# VITE_API_PREFIX=/api/v1
